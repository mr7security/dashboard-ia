# Copiar a /etc/dashboard-ia.env  (propietario root, permisos 600)

# ChatGPT Enterprise: Admin key del workspace, creada en la Admin Console
# (Credentials > Admin keys) con permisos de lectura, y el UUID del workspace.
CHATGPT_ADMIN_KEY=
CHATGPT_WORKSPACE_ID=

# Microsoft 365 Copilot (opcional). Aplicación registrada en Entra ID con el permiso
# de aplicación Reports.Read.All de Microsoft Graph y consentimiento de administrador.
COPILOT_TENANT_ID=
COPILOT_CLIENT_ID=
COPILOT_CLIENT_SECRET=
# Segundo tenant, si lo hay: COPILOT2_TENANT_ID, COPILOT2_CLIENT_ID, COPILOT2_CLIENT_SECRET
# y, para distinguirlos en el panel, COPILOT_NOMBRE y COPILOT2_NOMBRE.

# Claude (plan Team): clave que pide el panel para subir los CSV exportados de claude.ai
# (lista de miembros e informe de gasto). Sin ella, la subida queda desactivada.
DASH_CLAVE_SUBIDA=

# Usuario y contraseña para entrar al dashboard (recomendado: muestra emails y uso del personal)
DASH_USUARIO=
DASH_CLAVE=
