# Copiar a /etc/dashboard-ia.env  (propietario root, permisos 600)

# ChatGPT Enterprise: Admin key del workspace, creada en la Admin Console
# (Credentials > Admin keys) con permisos de lectura, y el UUID del workspace.
CHATGPT_ADMIN_KEY=
CHATGPT_WORKSPACE_ID=

# Usuario y contraseña para entrar al dashboard (recomendado: muestra emails y uso del personal)
DASH_USUARIO=
DASH_CLAVE=
